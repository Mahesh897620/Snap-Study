# Copy to secrets.toml locally, or paste into Streamlit Cloud's Secrets panel.
# Empty key = labelled offline demo. Never commit real credentials.
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-3.5-flash"

# Optional Gmail delivery; downloads always work without this.
GMAIL_ADDRESS = ""
GMAIL_APP_PASSWORD = ""
# Comma-separated approved recipient inboxes. Empty means sender inbox only.
MAIL_ALLOWED_RECIPIENTS = ""
